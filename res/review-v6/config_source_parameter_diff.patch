+void TestTransactionAdmissionBandwidth() {
+    auto config = ArchitectureConfig::Load("configs/HYGCN_PAPER.ini");
+    config.hbm_channels = 4;
+    config.hbm_banks_per_channel = 1;
+    config.hbm_transaction_queue_entries_per_channel = 2;
