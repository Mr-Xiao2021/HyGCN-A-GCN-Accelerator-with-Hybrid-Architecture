      "command_issue_interval_formula": "ceil(tCK / model_cycle_ns); each physical channel issues row commands on its own replicated DRAMSim3 command lane",
      "command_model": "request completion is measured from actual READ/WRITE issue; row conflicts explicitly schedule PRE then ACT before the data command, while tWR/tRTP/tRAS and PRE-to-ACT constrain recovery",
      "config": "configs/HBM1_4Gb_x128.ini",
      "model_cycle_ns": "1 / architecture.frequency_ghz",
      "precharge_to_activate_formula": "ceil(tRP * tCK / model_cycle_ns)",
      "read_row_conflict_formula": "ceil((tRP + tRCDRD + CL) * tCK / model_cycle_ns)",
      "read_row_hit_formula": "ceil(CL * tCK / model_cycle_ns)",
      "read_row_miss_formula": "ceil((tRCDRD + CL) * tCK / model_cycle_ns)",
      "read_to_precharge_formula": "ceil((AL + tRTP) * tCK / model_cycle_ns); bundled HBM config omits tRTP, so DRAMSim3 default tRTP=5 applies",
      "read_to_write_formula": "ceil((RL + burst_cycle - WL + tRTRS) * tCK / model_cycle_ns)",
      "same_direction_formula": "ceil(max(burst_cycle, tCCD_L) * tCK / model_cycle_ns)",
      "source": "bundled DRAMSim3 HBM timing configuration",
      "transfer_note": "burst/block transfer is modeled separately by transfer_cycles, so BL is not duplicated in CL/CWL completion latency",
      "write_row_conflict_formula": "ceil((tRP + tRCDWR + CWL) * tCK / model_cycle_ns)",
      "write_row_hit_formula": "ceil(CWL * tCK / model_cycle_ns)",
      "write_row_miss_formula": "ceil((tRCDWR + CWL) * tCK / model_cycle_ns)",
      "write_to_precharge_formula": "ceil((WL + burst_cycle + tWR) * tCK / model_cycle_ns)",
      "write_to_read_formula": "ceil((write_delay + tWTR_L) * tCK / model_cycle_ns)"
    },
